  "rf_candidates": [{"n_estimators": 200, "max_depth": 12, "min_samples_leaf": 3}, {"n_estimators": 200, "max_depth": null, "min_samples_leaf": 5}],
  "xgb_candidates": [{"n_estimators": 500, "max_depth": 3, "learning_rate": 0.04}, {"n_estimators": 500, "max_depth": 5, "learning_rate": 0.04}],
  "lstm": {"hidden_size": 48, "layers": 1, "batch_size": 256, "learning_rate": 0.001, "max_epochs": 60, "patience": 10},
  "spread_multiplier": 1.96,
  "bootstrap_repeats": 2000,
  "maintenance_rul_thresholds": {"red_below": 20, "orange_below": 40, "yellow_below": 80},
  "threads": 4
